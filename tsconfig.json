{
    "include": ["src"],
    "compilerOptions": {
        "module": "preserve",
        "target": "es2024",
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "strict": true,
        "noLib": true,
        "types": ["@bedrock-apis/env-types"],
        "noEmit": true,
        "paths": {
            "*": ["./src/*"]
        }
    }
}
